{
  "name": "scs-intellisense",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "config/*"
  ],
  "scripts": {
    "copy-server": "copyfiles -u 3 apps/server/dist/**/* apps/client/dist/",
    "copy-readme": "copyfiles ./README.md apps/client/",
    "build": "pnpm i && pnpm -r run build && pnpm run copy-server && pnpm run copy-readme",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:staged": "lint-staged",
    "package:client": "pnpm --filter ./apps/client run vsce:package",
    "compile": "pnpm run build && pnpm run package:client",
    "release:workspaces": "pnpm --filter ./apps/server run release && pnpm --filter ./apps/client run release",
    "release": "pnpm run release:workspaces && pnpm --filter ./apps/client run vsce:package && release-it && pnpm run vsce:publish",
    "vsce:publish": "pnpm --filter ./apps/client/ vsce:publish",
    "publish-vsce": "node ./scripts/publish-vsce.mjs"
  },
  "devDependencies": {
    "@release-it/bumper": "^7.0.6",
    "@scs-int/ts-config": "workspace:*",
    "copyfiles": "^2.4.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@release-it/conventional-changelog": "^11.0.1",
    "release-it": "^20.2.0"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": false,
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true,
      "assets": [
        "./release/latest/*.vsix"
      ]
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "refactor",
              "section": "Refactors"
            },
            {
              "type": "perf",
              "section": "Performance Improvements"
            },
            {
              "type": "revert",
              "section": "Reverts"
            },
            {
              "type": "docs",
              "section": "Documentation"
            }
          ]
        }
      }
    }
  }
}
