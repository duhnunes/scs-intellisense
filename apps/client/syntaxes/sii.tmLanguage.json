{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SCS Intellisense",
  "scopeName": "source.sii",
  "patterns": [
    { "include": "#root" },
    { "include": "#root_block" },
    { "include": "#class_block" },
    { "include": "#class" },
    { "include": "#attribute_array" },
    { "include": "#attribute" },
    { "include": "#value_string" },
    { "include": "#parens_number" },
    { "include": "#value_number" },
    { "include": "#value_boolean" },
    { "include": "#include_directive" },
    { "include": "#include_quote_punct" },
    { "include": "#comments" }
  ],
  "repository": {
    "root": {
      "match": "\\bSiiNunit\\b",
      "name": "keyword.control.sii"
    },
    "root_block": {
      "begin": "\\b(SiiNunit)\\b\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.sii" },
        "2": { "name": "punctuation.section.block.begin.sii" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.sii" }
      },
      "name": "meta.block.root.sii",
      "patterns": [
        { "include": "#class" },
        { "include": "#class_block" },
        { "include": "#comments" }
      ]
    },

    "class": {
      "match": "^\\s*([A-Za-z0-9_.-]+)(\\s+)(:)",
      "captures": {
        "1": { "name": "entity.name.type.sii" },
        "2": { "name": "punctuation.whitespace.separator.sii" },
        "3": { "name": "punctuation.separator.key-value.sii" }
      }
    },
    "class_block": {
      "begin": "^\\s*([A-Za-z0-9_.-]+)\\s*(:)\\s*(?:[a-z0-9_]+)\\.\\s*(?:[A-Za-z0-9_.-]+)?\\s*(\\{)?",
      "beginCaptures": {
        "1": { "name": "entity.name.type.sii" },
        "2": { "name": "punctuation.separator.whitespace-separatator.sii" },
        "3": { "name": "punctuation.separator.key-value.sii" },
        "4": { "name": "punctuation.section.block.begin.sii" }
      },
      "end": "^\\s*\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.sii" }
      },
      "name": "meta.entry.block.sii",
      "patterns": [
        { "include": "#class_block_attribute_line" },
        { "include": "#attribute_array" },
        { "include": "#attribute" },
        { "include": "#value_string" },
        { "include": "#parens_number" },
        { "include": "#value_number" },
        { "include": "#value_boolean" },
        { "include": "#include_directive" },
        { "include": "#include_quote_punct" },
        { "include": "#comments" }
      ]
    },

    "attribute_array": {
      "match": "^\\s+([A-Za-z0-9_.-]+)(\\[(\\d*)\\])(?=\\s*:)",
      "captures": {
        "1": { "name": "variable.parameter.attribute.array.sii" },
        "2": { "name": "variable.parameter.attribute.array.sii" },
        "3": { "name": "constant.numeric.arrayindex.sii" }
      }
    },
    "attribute": {
      "match": "^\\s+([A-Za-z0-9_.-]+)\\b(?=\\s*:)",
      "captures": {
        "1": { "name": "variable.parameter.attribute.sii" }
      }
    },

    "value_string": {
      "begin": "(?<=:\\s*)(\")",
      "beginCaptures": {
        "1": { "name": "string.quoted.double.sii" }
      },
      "end": "(?<!\\\\)\"",
      "endCaptures": {
        "0": { "name": "string.quoted.double.sii" }
      },
      "name": "string.quoted.double.sii",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.sii"
        }
      ]
    },
    "value_number": {
      "match": "(?<=:\\s*)(?:-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)",
      "name": "constant.numeric.sii"
    },
    "value_boolean": {
      "match": "(?<=:\\s*)\\b(?:true|false)\\b",
      "name": "constant.language.boolean.sii"
    },
    "parens_number": {
      "match": "(?:\\(|,|;)\\s*([+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\s*(?=\\s*(?:,|;|\\)))",
      "captures": {
        "1": { "name": "constant.numeric.sii" }
      },
      "name": "meta.number.in.parens.sii"
    },

    "include_directive": {
      "match": "^\\s*(@include)\\b\\s*",
      "captures": {
        "1": { "name": "keyword.control.include.sii" },
        "2": { "name": "string.quote.include.sii" }
      },
      "name": "meta.directive.include.sii"
    },
    "include_quote_punct": {
      "begin": "(?<=@include\\s*)(\")",
      "beginCaptures": {
        "1": { "name": "string.quoted.double.sii" }
      },
      "end": "(?<!\\\\)\"",
      "endCaptures": {
        "0": { "name": "string.quoted.double.sii" }
      },
      "name": "string.quoted.double.sii",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.sii"
        }
      ]
    },

    "comments": {
      "patterns": [
        {
          "match": "#.*$",
          "name": "comment.line.sii"
        },
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.sii"
        },
        {
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.sii" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.sii" }
          },
          "name": "comment.block.sii"
        }
      ]
    }
  }
}
