{
  "name": "scs-intellisense",
  "version": "0.5.0",
  "displayName": "SCS IntelliSense (SCS Software)",
  "description": "Extension to add intellisense for SCS Software files.",
  "author": "DuH Nunes",
  "license": "MIT",
  "homepage": "https://github.com/duhnunes/scs-intellisense",
  "bugs": {
    "url": "https://github.com/duhnunes/scs-intellisense/issues",
    "email": "duhnunes.dev@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/duhnunes/scs-intellisense.git"
  },
  "publisher": "DuHNunes",
  "keywords": [
    "scs software",
    "scs-software",
    "scs intellisense",
    "scs-intellisense",
    "SCS IntelliSense",
    "ats",
    "ets2"
  ],
  "icon": "public/icon.png",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "engines": {
    "vscode": "^1.118.0"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": false
  },
  "scripts": {
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.cjs",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.cjs --production",
    "build": "pnpm i && pnpm run check-types && pnpm run lint && node esbuild.cjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.cjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "vsce:package": "vsce package && node ../../scripts/release-artifact-manager.mjs",
    "vsce:publish": "vsce publish"
  },
  "devDependencies": {
    "@scs-int/eslint-config": "workspace:^",
    "@scs-int/ts-config": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "vsce": {
    "dependencies": false
  },
  "release-it": {
    "git": false,
    "npm": {
      "publish": false
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "sii",
        "aliases": ["SII", "sii", "SCS Software", "SCS"],
        "extensions": [".sii"],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./public/extensions/sii.png",
          "light": "./public/extensions/sii.png"
        }
      },
      {
        "id": "sui",
        "aliases": ["SUI", "sui", "SCS Software", "SCS"],
        "extensions": [".sui"],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./public/extensions/sui.png",
          "light": "./public/extensions/sui.png"
        }
      },
      {
        "id": "pmd",
        "aliases": ["pmd", "PMD", "SCS Software", "SCS"],
        "extensions": [".pmd"],
        "icon": {
          "dark": "./public/extensions/pmd.png",
          "light": "./public/extensions/pmg.png"
        }
      },
      {
        "id": "pmg",
        "aliases": ["pmg", "PMG", "SCS Software", "SCS"],
        "extensions": [".pmg"],
        "icon": {
          "dark": "./public/extensions/pmg.png",
          "light": "./public/extensions/pmg.png"
        }
      },
      {
        "id": "pmc",
        "aliases": ["pmc", "PMC", "SCS Software", "SCS"],
        "extensions": [".pmc"],
        "icon": {
          "dark": "./public/extensions/pma.png",
          "light": "./public/extensions/pma.png"
        }
      },
      {
        "id": "pma",
        "aliases": ["pma", "PMA", "SCS Software", "SCS"],
        "extensions": [".pma"],
        "icon": {
          "dark": "./public/extensions/pma.png",
          "light": "./public/extensions/pma.png"
        }
      },
      {
        "id": "pit",
        "aliases": ["pit", "PIT", "SCS Software", "SCS"],
        "extensions": [".pit"],
        "icon": {
          "dark": "./public/extensions/pit.png",
          "light": "./public/extensions/pit.png"
        }
      },
      {
        "id": "pim",
        "aliases": ["pim", "PIM", "SCS Software", "SCS"],
        "extensions": [".pim"],
        "icon": {
          "dark": "./public/extensions/pim.png",
          "light": "./public/extensions/pim.png"
        }
      },
      {
        "id": "pic",
        "aliases": ["pic", "PIC", "SCS Software", "SCS"],
        "extensions": [".pic"],
        "icon": {
          "dark": "./public/extensions/pic.png",
          "light": "./public/extensions/pic.png"
        }
      },
      {
        "id": "pia",
        "aliases": ["pia", "PIA", "SCS Software", "SCS"],
        "extensions": [".pia"],
        "icon": {
          "dark": "./public/extensions/pia.png",
          "light": "./public/extensions/pia.png"
        }
      },
      {
        "id": "pip",
        "aliases": ["pip", "PIP", "SCS Software", "SCS"],
        "extensions": [".pip"],
        "icon": {
          "dark": "./public/extensions/pip.png",
          "light": "./public/extensions/pip.png"
        }
      },
      {
        "id": "tobj",
        "aliases": ["tojb", "TOBJ"],
        "extensions": [".tobj"],
        "icon": {
          "dark": "./public/extensions/tobj.png",
          "light": "./public/extensions/tobj.png"
        }
      },
      {
        "id": "mat",
        "aliases": ["mat", "MAT"],
        "extensions": [".mat"],
        "icon": {
          "dark": "./public/extensions/mat.png",
          "light": "./public/extensions/mat.png"
        }
      },
      {
        "id": "sndr",
        "aliases": ["sndr", "SNDR", "SCS Software", "SCS"],
        "extensions": [".soundref"],
        "icon": {
          "dark": "./public/extensions/sndr.png",
          "light": "./public/extensions/sndr.png"
        }
      },
      {
        "id": "zip",
        "aliases": ["zip", "ZIP"],
        "extensions": [".zip"],
        "icon": {
          "dark": "./public/extensions/zip.png",
          "light": "./public/extensions/zip.png"
        }
      },
      {
        "id": "scs",
        "aliases": ["scs", "SCS", "SCS Software"],
        "extensions": [".scs"],
        "icon": {
          "dark": "./public/extensions/scs.png",
          "light": "./public/extensions/scs.png"
        }
      }
    ],
    "commands": [
      {
        "command": "scsIntellisense.showOutput",
        "title": "Show Output",
        "category": "SCS Intellisense"
      },
      {
        "command": "scsIntellisense.clearOutput",
        "title": "Clear Output",
        "category": "SCS Intellisense"
      },
      {
        "command": "scsIntellisense.refreshSchema",
        "title": "Refresh Schema Database",
        "category": "SCS Intellisense"
      }
    ],
    "capabilities": {},
    "configuration": {
      "title": "SCS Intellisense",
      "properties": {
        "scs-intellisense.semanticHighlighting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable/disable semantic highlighting"
        },
        "scs-intellisense.diagnostics.enabledSeverities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["error", "warning", "information", "hint"]
          },
          "default": ["error", "warning", "information", "hint"],
          "markdownDescription": "Which diagnostic severities SCS IntelliSense should report. Uncheck any you'd like hidden — for example, uncheck `warning` to keep only load-breaking `error` diagnostics."
        },
        "scs-intellisense.schema.fetchTimeoutMs": {
          "type": "number",
          "default": 8000,
          "minimum": 1000,
          "markdownDescription": "How long (in milliseconds) a single completion/hover request waits for the schema database before giving up on *that* request. The fetch itself is never cancelled — it keeps running in the background and gets cached regardless, so the next request benefits even if this one timed out. Requires a window reload to take effect."
        }
      }
    },
    "configurationDefaults": {
      "[sii]": {
        "editor.wordBasedSuggestions": "off"
      },
      "[sui]": {
        "editor.wordBasedSuggestions": "off"
      }
    }
  }
}