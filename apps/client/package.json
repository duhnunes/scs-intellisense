{
  "name": "scs-intellisense",
  "version": "0.0.9",
  "displayName": "SCS Intellisense",
  "description": "Extension to add intellisense for SCS Software files.",
  "author": "DuH Nunes",
  "license": "MIT",
  "homepage": "https://github.com/duhnunes/scs-intellisense",
  "bugs": {
    "url": "https://github.com/duhnunes/scs-intellisense/issues",
    "email": "duhnunes.dev@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/duhnunes/scs-intellisense.git"
  },
  "publisher": "DuHNunes",
  "keywords": [
    "scs software",
    "scs-software",
    "scs intellisense",
    "scs-intellisense",
    "ats",
    "ets2"
  ],
  "icon": "public/icon.png",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "engines": {
    "vscode": "^1.118.0"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "sii",
        "aliases": [
          "SII",
          "sii",
          "SCS Software",
          "SCS"
        ],
        "extensions": [
          ".sii"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sui",
        "aliases": [
          "SUI",
          "sui",
          "SCS Software",
          "SCS"
        ],
        "extensions": [
          ".sui"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "scsIntellisense.showOutput",
        "title": "SCS Intellisense: Show Output",
        "category": "SCS Intellisense"
      },
      {
        "command": "scsIntellisense.clearOutput",
        "title": "SCS Intellisense: Clear Output",
        "category": "SCS Intellisense"
      }
    ],
    "capabilities": {},
    "configuration": {
      "title": "SCS Intellisense",
      "properties": {
        "scs-intellisense.semanticHighlighting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable/disable semantic highlighting"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.cjs",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.cjs --production",
    "build": "pnpm i && pnpm run check-types && pnpm run lint && node esbuild.cjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.cjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "vsce:package": "vsce package && node ../../scripts/release-artifact-manager.mjs",
    "release": "release-it"
  },
  "devDependencies": {
    "@scs-int/eslint-config": "workspace:^",
    "@scs-int/ts-config": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "vsce": {
    "dependencies": false
  },
  "release-it": {
    "git": false,
    "npm": {
      "publish": false
    }
  }
}
