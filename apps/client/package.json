{
  "name": "scs-intellisense",
  "version": "0.8.0",
  "displayName": "SCS IntelliSense for ATS & ETS2",
  "description": "Extension to add intellisense for SCS Software files.",
  "author": "DuH Nunes",
  "license": "MIT",
  "homepage": "https://scs-intellisense.vercel.app/docs",
  "bugs": {
    "url": "https://github.com/duhnunes/scs-intellisense/issues",
    "email": "duhnunes.dev@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/duhnunes/scs-intellisense.git"
  },
  "publisher": "DuHNunes",
  "keywords": [
    "scs software",
    "scs-software",
    "scs intellisense",
    "scs-intellisense",
    "SCS IntelliSense",
    "ats",
    "ets2"
  ],
  "icon": "public/icon.png",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "engines": {
    "vscode": "^1.118.0"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": false
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package:server && pnpm -w run copy-server && pnpm run package",
    "package:server": "pnpm --filter scs-int-server run check-types && pnpm --filter scs-int-server exec node esbuild.cjs --production",
    "build:dev": "pnpm --filter scs-int-server run check-types && pnpm --filter scs-int-server exec node esbuild.cjs && pnpm -w run copy-server && pnpm run compile",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.cjs",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.cjs --production",
    "build": "pnpm i && pnpm run check-types && pnpm run lint && node esbuild.cjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.cjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "vsce:package": "vsce package && node ../../scripts/release-artifact-manager.mjs",
    "vsce:publish": "vsce publish"
  },
  "devDependencies": {
    "@scs-int/eslint-config": "workspace:^",
    "@scs-int/ts-config": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "vsce": {
    "dependencies": false
  },
  "release-it": {
    "git": false,
    "npm": {
      "publish": false
    }
  },
