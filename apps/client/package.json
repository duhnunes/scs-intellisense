    "grammars": [
      {
        "language": "sii",
        "scopeName": "source.sii",
        "path": "./syntaxes/sii.tmLanguage.json"
      },
      {
        "language": "sui",
        "scopeName": "source.sui",
        "path": "./syntaxes/sui.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "scsIntellisense.showOutput",
        "title": "Show Output",
        "category": "SCS IntelliSense"
      },
      {
        "command": "scsIntellisense.clearOutput",
        "title": "Clear Output",
        "category": "SCS IntelliSense"
      },
      {
        "command": "scsIntellisense.copyBugReportInfo",
        "title": "Copy Bug Report Info",
        "category": "SCS IntelliSense"
      },
      {
        "command": "scsIntellisense.refreshSchema",
        "title": "Refresh Schema Database",
        "category": "SCS IntelliSense"
      },
      {
        "command": "scsIntellisense.checkFormatting",
        "title": "Check Formatting of All Files",
        "category": "SCS IntelliSense"
      },
      {
        "command": "scsIntellisense.formatAllFiles",
        "title": "Format All Files",
        "category": "SCS IntelliSense"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "scsIntellisense.checkFormatting",
          "when": "config.scs-intellisense.formatter.enabled"
        },
        {
          "command": "scsIntellisense.formatAllFiles",
          "when": "config.scs-intellisense.formatter.enabled"
        }
      ]
    },
    "capabilities": {},
    "configuration": [
      {
        "id": "general.scs-intellisense",
        "title": "General",
        "order": 1,
        "properties": {
          "scs-intellisense.semanticHighlighting": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Color `.sii`/`.sui` files by meaning (class names, unit names, keys, values). On by default for these files only, even when a theme or `#editor.semanticHighlighting.enabled#` turns it off elsewhere. Takes effect right away.",
            "order": 1
          }
        }
      },
      {
        "id": "diagnostics.scs-intellisense",
        "title": "Diagnostics",
        "order": 2,
        "properties": {
          "scs-intellisense.diagnostics.enabledSeverities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "information",
                "hint"
              ]
            },
            "default": [
              "error",
              "warning",
              "information",
              "hint"
            ],
            "markdownDescription": "Which diagnostic severities SCS IntelliSense should report. Uncheck any you'd like hidden — for example, uncheck `warning` to keep only load-breaking `error` diagnostics.",
            "order": 1
          }
        }
      },
      {
        "id": "completion.scs-intellisense",
        "title": "Completion & Hover",
        "order": 3,
        "properties": {
          "scs-intellisense.completion.enabled": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "**EXPERIMENTAL** — Enable completion of `class_name`, `attribute_key`, `enum` values, pointers to units (of the same file and the rest of the mod) and file paths, backed by the community schema database. (`@include` paths are always suggested.) Off by default while this feature is still being validated. Takes effect right away.",
            "order": 1
          },
          "scs-intellisense.hover.enabled": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "**EXPERIMENTAL** — Enable hover information for `class_name` and `attribute_key`, backed by the community schema database. Off by default while this feature is still being validated. Takes effect right away.",
            "order": 2
          },
          "scs-intellisense.schema.fetchTimeoutMs": {
            "type": "number",
            "default": 8000,
            "minimum": 1000,
            "markdownDescription": "How long (in milliseconds) a single completion/hover request waits for the schema database before giving up on *that* request. The fetch itself is never cancelled — it keeps running in the background and gets cached regardless, so the next request benefits even if this one timed out. Takes effect right away.",
            "order": 3
          }
        }
      },
      {
        "id": "formatter.scs-intellisense",
        "title": "Formatter",
        "order": 4,
        "properties": {
          "scs-intellisense.formatter.enabled": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "**EXPERIMENTAL** — Enable formatting (Format Document) for `.sii`/`.sui` files. Rewrites indentation, brace placement, spacing around `:`, blank lines, and `@include` placement — never touches attribute values. Off by default while this feature is still being validated. Takes effect right away.",
            "order": 1
          },
          "scs-intellisense.formatter.formatOnSave": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Format `.sii`/`.sui` files when you save them. Only works while `#scs-intellisense.formatter.enabled#` is on, and doesn't need VS Code's own `#editor.formatOnSave#`. A file with structural errors is saved as it is, without formatting. Takes effect right away.",
            "order": 2
          },
          "scs-intellisense.formatter.braceStyle": {
            "type": "string",
            "enum": [
              "1tbs",
              "allman"
            ],
            "enumDescriptions": [
              "Opening brace on the same line (e.g. \"class_name : unit.name {\")",
              "Opening brace on its own line below (the style the game's own files use)"
            ],
            "default": "1tbs",
            "markdownDescription": "Brace style used when formatting `.sii`/`.sui` files. Only takes effect if `#scs-intellisense.formatter.enabled#` is on.",
            "order": 3
          },
          "scs-intellisense.formatter.indentUnits": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Indent the units inside `SiiNunit { }` one level. Uncheck to keep them at column 0. Game files use both styles. Doesn't apply to `.sui` files, which have no `SiiNunit`. The indent itself (tab or spaces, and their size) follows your editor settings: `#editor.tabSize#`, `#editor.insertSpaces#` and `#editor.detectIndentation#`. Takes effect right away.",
            "order": 4
          }
        }
      },
      {
        "id": "fileMoves.scs-intellisense",
        "title": "File Moves",
        "order": 5,
        "properties": {
          "scs-intellisense.fileMoves.autoSave": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Save the files whose paths a rename or move updated, and close the tabs VS Code opened for them, as set by `#scs-intellisense.fileMoves.alwaysSave#` and `#scs-intellisense.fileMoves.saveAbove#`. Uncheck to always leave them open and unsaved, with the changed lines marked, for you to review. Paths are updated either way. Files you had unsaved changes in are never saved for you. Takes effect right away.",
            "order": 1
          },
          "scs-intellisense.fileMoves.alwaysSave": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\.[A-Za-z0-9]+$",
              "patternErrorMessage": "A file extension starting with a dot, such as .mat"
            },
            "default": [
              ".mat"
            ],
            "markdownDescription": "File types saved and closed after every rename or move, however many: `.mat` files are usually written by SCS Blender Tools' converter, and a texture folder can be named in dozens of them. Only while `#scs-intellisense.fileMoves.autoSave#` is on. Takes effect right away.",
            "order": 2
          },
          "scs-intellisense.fileMoves.saveAbove": {
            "type": "number",
            "default": 6,
            "minimum": 0,
            "markdownDescription": "When a rename or move updates paths in more than this many files (not counting the types in `#scs-intellisense.fileMoves.alwaysSave#`), they're saved too and their tabs closed. Up to this many, they stay open and unsaved, with the changed lines marked, for you to review. `0` always saves. Only while `#scs-intellisense.fileMoves.autoSave#` is on. Takes effect right away.",
            "order": 3
          },
          "scs-intellisense.fileMoves.notify": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Show a notification when files are saved after a rename or move. It's always written to the extension's log (**SCS IntelliSense: Show Output**). Takes effect right away.",
            "order": 4
          }
        }
      }
    ],
    "configurationDefaults": {
      "[sii]": {
        "editor.wordBasedSuggestions": "off",
        "editor.defaultFormatter": "DuHNunes.scs-intellisense",
        "editor.semanticHighlighting.enabled": true
      },
      "[sui]": {
        "editor.wordBasedSuggestions": "off",
        "editor.defaultFormatter": "DuHNunes.scs-intellisense",
        "editor.semanticHighlighting.enabled": true
      }
    }
  }
}
