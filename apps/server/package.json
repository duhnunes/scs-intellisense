{
  "name": "scs-int-server",
  "version": "0.2.0",
  "author": "DuHNunes",
  "main": "./dist/server.js",
  "scripts": {
    "build": "pnpm i && pnpm run check-types && node esbuild.cjs",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "lint:check": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --mx-wrnings=0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@scs-int/eslint-config": "workspace:^",
    "@scs-int/ts-config": "workspace:*",
    "@types/node": "~22.19.18",
    "esbuild": "^0.27.3",
    "eslint": "^10.4.0",
    "typescript": "^5.9.3"
  },
  "release-it": {
    "git": false,
    "npm": {
      "publish": false
    }
  }
}
